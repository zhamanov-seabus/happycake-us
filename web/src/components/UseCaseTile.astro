---
import { withBase } from '../lib/url';

interface Props {
  href: string;
  photo: string;
  alt: string;
  title: string;
  body: string;
  cta: string;
}
const { href, photo, alt, title, body, cta } = Astro.props;
const isExternal = href.startsWith('http');
const finalHref = isExternal ? href : withBase(href);
---
<a class="usecase" href={finalHref}>
  <img src={withBase(photo)} alt={alt} loading="lazy" />
  <div class="usecase-body">
    <h3>{title}</h3>
    <p>{body}</p>
    <span class="usecase-arrow">{cta}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </span>
  </div>
</a>

<style is:global>
  .usecase-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  @media (max-width: 880px) { .usecase-grid { grid-template-columns: 1fr; } }

  .usecase {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: end;
    color: #fff;
    isolation: isolate;
    transition: transform .3s ease;
  }
  .usecase:hover { transform: translateY(-3px); }
  .usecase img {
    position: absolute; inset: 0; z-index: -2;
    width: 100%; height: 100%; object-fit: cover;
    transition: transform .6s ease;
  }
  .usecase:hover img { transform: scale(1.04); }
  .usecase::after {
    content: ""; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(180deg, rgba(58,42,31,0) 35%, rgba(58,42,31,0.78) 100%);
  }
  .usecase-body { padding: 24px 24px 26px; }
  .usecase h3 {
    color: #fff;
    font-size: 28px;
    line-height: 1.05;
    margin-bottom: 8px;
  }
  .usecase p {
    margin: 0;
    font-size: 14.5px;
    color: rgba(255,255,255,0.86);
    line-height: 1.5;
    max-width: 30ch;
  }
  .usecase-arrow {
    margin-top: 16px;
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase;
    color: #fff;
  }
  .usecase-arrow svg { transition: transform .25s ease; }
  .usecase:hover .usecase-arrow svg { transform: translateX(4px); }
</style>
