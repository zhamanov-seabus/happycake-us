---
import { withBase } from '../lib/url';

interface Props {
  /** Path under /images/, e.g. /images/happy-cake-hero-01.webp */
  photo?: string;
  alt?: string;
  eyebrow?: string;
  metaText?: string;
}

const {
  photo = '/images/happy-cake-hero-01.webp',
  alt = 'Honey cake fresh from the HappyCake kitchen',
  eyebrow = 'Sugar Land · Family bakery',
  metaText = 'Open today · Walk-ins welcome',
} = Astro.props;
---
<section class="hero" data-screen-label="Hero">
  <div class="hero-meta" aria-live="polite">
    <span class="dot" aria-hidden="true"></span>
    <span>{metaText}</span>
  </div>

  <div class="hero-grid wrap">
    <div class="hero-text">
      <span class="hero-eyebrow">{eyebrow}</span>
      <h1>The original taste of <em>happiness.</em></h1>
      <p class="lead">Hand-built cakes in Sugar Land. Pick up today, or order ahead for the moments that matter.</p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="#catalog">See today's cakes
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a class="btn btn-secondary" href="https://wa.me/" target="_blank" rel="noopener">
          <svg class="wa-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9s-.5-.1-.6.1c-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.4-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.2-.5.1-.2 0-.4 0-.5s-.6-1.5-.9-2c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.4s-.9.9-.9 2.2.9 2.5 1 2.7c.1.2 1.8 2.8 4.5 3.9 2.2.9 2.7.7 3.2.7s1.7-.7 1.9-1.4c.2-.6.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3zM12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.5 1.3 5L2 22l5.1-1.3c1.4.8 3.1 1.2 4.9 1.2 5.5 0 10-4.5 10-10S17.5 2 12 2z"/></svg>
          Message us on WhatsApp
        </a>
      </div>
    </div>

    <figure class="hero-image">
      <img class="hero-photo" src={withBase(photo)} alt={alt} loading="eager" />
    </figure>
  </div>
</section>

<style is:global>
  .hero {
    position: relative;
    background: linear-gradient(180deg, #FAF3E7 0%, #F4E9D5 100%);
    overflow: hidden;
    isolation: isolate;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    padding-top: clamp(48px, 8vw, 96px) !important;
    padding-bottom: clamp(48px, 8vw, 96px) !important;
  }
  .hero-text { color: var(--cocoa); }
  .hero-eyebrow {
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.75;
    margin-bottom: 20px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--cocoa);
  }
  .hero-eyebrow::before {
    content: ""; display: block; width: 28px; height: 1px; background: rgba(58,42,31,0.55);
  }
  .hero h1 {
    color: var(--cocoa);
    font-size: clamp(40px, 5.6vw, 72px);
    line-height: 1.0;
    letter-spacing: -0.025em;
    font-weight: 400;
    max-width: 14ch;
    margin-bottom: 22px;
  }
  .hero h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--honey, #C68A2E);
  }
  .hero p.lead {
    font-size: clamp(16px, 1.4vw, 19px);
    max-width: 50ch;
    color: rgba(58,42,31,0.78);
    margin: 0 0 32px;
    line-height: 1.55;
  }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }

  .hero-image {
    margin: 0;
    justify-self: end;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 4 / 5;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 24px 60px -20px rgba(58,42,31,0.35);
  }
  .hero-photo {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-meta {
    position: absolute;
    top: 28px; right: var(--gutter);
    display: inline-flex; align-items: center; gap: 10px;
    background: rgba(255,255,255,0.92);
    color: var(--cocoa);
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    font-size: 13px;
    box-shadow: var(--shadow-sm);
    backdrop-filter: blur(4px);
    z-index: 1;
  }
  .hero-meta .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--sage-deep); box-shadow: 0 0 0 4px rgba(141,161,127,0.18); }

  @media (max-width: 880px) {
    .hero-grid { grid-template-columns: 1fr; gap: 36px; }
    .hero-image { max-width: 100%; aspect-ratio: 4 / 3; justify-self: stretch; }
    .hero-meta { display: none; }
  }
</style>
