---
// On-site assistant widget — POSTs to wrapper /chat.
// Wrapper URL is configured via PUBLIC_WRAPPER_URL env at build time, defaults to relative /chat.
const wrapperUrl = import.meta.env.PUBLIC_WRAPPER_URL ?? 'http://localhost:8000';
---
<button id="assistant-fab" class="assistant-fab" aria-label="Chat with HappyCake" title="Ask HappyCake">💬</button>
<div id="assistant-panel" class="assistant-panel" role="dialog" aria-label="HappyCake assistant">
  <header>Ask HappyCake</header>
  <div class="messages" id="assistant-messages">
    <div class="msg bot"><span class="bubble">Hi, friend. Ask about today's cakes, sizes, allergens, or pickup. Order on the site or send a message on WhatsApp.</span></div>
  </div>
  <form id="assistant-form" autocomplete="off">
    <input id="assistant-input" name="q" placeholder="What's on the counter today?" required />
    <button type="submit">Send</button>
  </form>
</div>
<script is:inline define:vars={{ wrapperUrl }}>
  const fab = document.getElementById('assistant-fab');
  const panel = document.getElementById('assistant-panel');
  const form = document.getElementById('assistant-form');
  const input = document.getElementById('assistant-input');
  const messages = document.getElementById('assistant-messages');

  fab.addEventListener('click', () => panel.classList.toggle('open'));

  function addMessage(role, text) {
    const el = document.createElement('div');
    el.className = 'msg ' + role;
    const bubble = document.createElement('span');
    bubble.className = 'bubble';
    bubble.textContent = text;
    el.appendChild(bubble);
    messages.appendChild(el);
    messages.scrollTop = messages.scrollHeight;
  }

  // One open EventSource at a time; replaced when a new order starts.
  let activeEs = null;

  function subscribeToOrder(orderId) {
    if (!orderId) return;
    if (activeEs) {
      try { activeEs.close(); } catch {}
    }
    const url = wrapperUrl + '/order/' + encodeURIComponent(orderId) + '/events';
    activeEs = new EventSource(url);
    activeEs.addEventListener('status', (ev) => {
      try {
        const update = JSON.parse(ev.data);
        const text = update.message || ('Status: ' + update.status);
        addMessage('bot', text);
        if (update.status === 'approved' || update.status === 'rejected') {
          try { activeEs.close(); } catch {}
          activeEs = null;
        }
      } catch (e) {}
    });
    activeEs.addEventListener('error', () => {
      // EventSource auto-reconnects on transient errors; only nuke if closed.
      if (activeEs && activeEs.readyState === EventSource.CLOSED) {
        activeEs = null;
      }
    });
  }

  async function send(text) {
    if (!text) return;
    addMessage('you', text);
    input.value = '';
    addMessage('bot', '…');
    try {
      const r = await fetch(wrapperUrl + '/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: text }),
      });
      const data = await r.json();
      messages.lastChild.querySelector('.bubble').textContent = data.reply || 'Sorry — let me get back to you on WhatsApp.';
      // If this turn produced an order id, listen for owner-side status events.
      subscribeToOrder(data.order_id);
    } catch (err) {
      messages.lastChild.querySelector('.bubble').textContent = 'The site assistant is offline. Send a message on WhatsApp or order at happycake.us.';
    }
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); send(input.value.trim()); });

  // Allow any element with data-prefill="..." to open the assistant pre-filled.
  // Used by "Order this cake" buttons and the /custom/ intake form.
  document.addEventListener('click', (e) => {
    const el = e.target.closest('[data-prefill]');
    if (!el) return;
    e.preventDefault();
    panel.classList.add('open');
    const text = el.getAttribute('data-prefill') || '';
    setTimeout(() => send(text), 50);
  });

  // Open with prefill from URL (?ask=) — used by deep links from product pages.
  try {
    const params = new URLSearchParams(window.location.search);
    const ask = params.get('ask');
    if (ask) {
      panel.classList.add('open');
      setTimeout(() => send(ask), 250);
    }
  } catch {}
</script>
