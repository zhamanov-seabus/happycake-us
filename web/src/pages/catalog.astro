---
import Layout from '../layouts/Layout.astro';
import { getCatalog, priceLabel } from '../lib/catalog';
import { withBase } from '../lib/url';
import { getInventory } from '../lib/sandbox';

const catalog = getCatalog();
const inventory = await getInventory();
const inventoryByVar = new Map(inventory.map(i => [i.variationId, i]));
---
<Layout title="Catalog">
  <section class="container">
    <h1>Catalog</h1>
    <p>Real cakes, made by hand in our Sugar Land kitchen.</p>

    {catalog.categories.map(cat => {
      const items = catalog.products.filter(p => p.category === cat.id);
      if (!items.length) return null;
      return (
        <div>
          <h2>{cat.name}</h2>
          <p>{cat.blurb}</p>
          <div class="grid">
            {items.map(p => (
              <article class="card">
                <a href={withBase(`/product/${p.slug}/`)}>
                  <img src={withBase(p.photo)} alt={p.name} loading="lazy" />
                </a>
                <div class="body">
                  <h3 set:html={p.display_name} />
                  {(() => {
                    const inv = inventoryByVar.get(p.variation_id);
                    if (!inv) return null;
                    return <span class={`stock-pill ${inv.inStock ? 'in' : 'out'}`}>{inv.inStock ? 'In stock today' : 'Sold out today'}</span>;
                  })()}
                  <p>{p.description}</p>
                  <div class="tags">
                    {p.tags.map(t => <span class="tag">{t}</span>)}
                  </div>
                  <div class="meta">
                    <span class="price">{priceLabel(p)}</span>
                    <span class="weight">{p.weight}</span>
                  </div>
                  <a href={withBase(`/product/${p.slug}/`)} class="cta">View &amp; order</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      );
    })}
  </section>
</Layout>
