---
import Layout from '../../layouts/Layout.astro';
import { getCatalog, priceLabel, type Product } from '../../lib/catalog';
import { withBase } from '../../lib/url';

export function getStaticPaths() {
  const catalog = getCatalog();
  return catalog.products.map((product: Product) => ({
    params: { slug: product.slug },
    props: { product, business: catalog.business, allProducts: catalog.products },
  }));
}

const { product: p, business: b, allProducts } = Astro.props;
const pairs: Product[] = (p.pairs_with ?? [])
  .map((slug: string) => (allProducts as Product[]).find(x => x.slug === slug))
  .filter((x): x is Product => Boolean(x));

const siteRoot = Astro.site?.toString().replace(/\/$/, '') ?? '';

// Per-product JSON-LD
const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  description: p.description,
  image: `${siteRoot}${withBase(p.photo)}`,
  brand: { '@type': 'Brand', name: b.name },
  category: p.category,
  weight: p.weight,
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    price: p.price_usd.toFixed(2),
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'Bakery', name: b.name },
  },
};
---
<Layout title={p.display_name} description={p.description} ogImage={p.photo}>
  <section class="container product">
    <img src={withBase(p.photo)} alt={p.name} />
    <div>
      <h1 set:html={p.display_name} />
      <div class="price-row">{priceLabel(p)} · {p.weight}</div>
      <p>{p.description}</p>
      <div class="tags">
        {p.tags.map((t: string) => <span class="tag">{t}</span>)}
        {p.dietary?.map((d: string) => <span class="tag">{d}</span>)}
      </div>

      {p.allergens && (
        <div class="allergens">
          <h4>Allergens</h4>
          {p.allergens.contains.length > 0 && (
            <div class="row">
              <strong style="font-size:0.82rem;color:var(--ink);">Contains:</strong>
              {p.allergens.contains.map((a: string) => <span class="pill contains">{a.replace('_', ' ')}</span>)}
            </div>
          )}
          {p.allergens.traces.length > 0 && (
            <div class="row">
              <strong style="font-size:0.82rem;color:var(--ink);">May contain (kitchen traces):</strong>
              {p.allergens.traces.map((a: string) => <span class="pill traces">{a.replace('_', ' ')}</span>)}
            </div>
          )}
          {p.allergens.note && <p style="margin:0.4rem 0 0;font-size:0.85rem;color:var(--muted);"><em>{p.allergens.note}</em></p>}
          <p style="margin:0.5rem 0 0;font-size:0.82rem;color:var(--muted);">Serious allergy? Tell us before ordering — the team reviews every flagged order.</p>
        </div>
      )}

      {p.requires_owner_approval && (
        <div class="order-note">
          <p><strong>Custom order.</strong> Decoration is a small, optional service. Tell us the date, the size, and any allergies — the team reviews each request before we promise a date.</p>
        </div>
      )}

      <div class="order-cta-row" data-product-id={p.variation_id}>
        <button
          type="button"
          class="order-button"
          data-prefill={`I'd like to order ${p.display_name} (${p.weight}, $${p.price_usd.toFixed(2)}) — variation ${p.variation_id}. Could you confirm pickup time?`}
          aria-label={`Order ${p.name}`}>
          Order this cake →
        </button>
        <a class="order-link" href={withBase(`/?ask=${encodeURIComponent("I'd like to order " + p.display_name + " — what's the earliest pickup?")}#order`)}>
          or open chat from anywhere
        </a>
      </div>

      <div class="order-note">
        <p>
          <strong>To order:</strong> tap the button above to start a chat with HappyCake right here. We confirm within the hour.<br />
          <em>{b.closing_pattern}</em>
        </p>
      </div>
    </div>
  </section>

  {pairs.length > 0 && (
    <section class="container">
      <h2>Often ordered together</h2>
      <div class="grid">
        {pairs.map((pp: Product) => (
          <article class="card">
            <a href={withBase(`/product/${pp.slug}/`)}>
              <img src={withBase(pp.photo)} alt={pp.name} loading="lazy" />
            </a>
            <div class="body">
              <h3 set:html={pp.display_name} />
              <p>{pp.description}</p>
              <div class="meta">
                <span class="price">{priceLabel(pp)}</span>
                <span class="weight">{pp.weight}</span>
              </div>
              <a href={withBase(`/product/${pp.slug}/`)} class="cta">View</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
</Layout>
