---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/url';

const ogImg = '/images/happy-cake-hero-02.webp';
---
<Layout
  title="HappyCake Franchise — Texas"
  description="Bring HappyCake to your Texas city. The Sugar Land flagship, the playbook, the AI sales engine, and the supply chain — wrapped into a single Texas franchise."
  ogImage={ogImg}
>
  <section class="fr-hero">
    <img class="fr-hero-photo" src={withBase('/images/happy-cake-hero-02.webp')} alt="HappyCake honey cake on linen" />
    <div class="fr-hero-inner">
      <span class="fr-eyebrow">Franchise · Texas only</span>
      <h1>Bring HappyCake to <span class="fr-italic">your Texas city.</span></h1>
      <p class="fr-lead">
        The Sugar Land flagship works. The recipes are written down. The marketing playbook
        is making $500 work like $5,000. We're opening the brand to operators across Texas —
        Houston, Dallas, Austin, San Antonio, Fort Worth, El Paso, Lubbock, Amarillo.
      </p>
      <a class="btn btn-primary" href="#franchise-apply">Apply for a territory →</a>
    </div>
  </section>

  <section class="fr-section" id="why">
    <div class="wrap">
      <span class="fr-eyebrow centered">Why HappyCake — Texas</span>
      <h2 class="fr-h2 centered">Six reasons families &amp; offices already choose us in Sugar Land,
        <span class="fr-italic">and why that scales.</span></h2>
      <div class="fr-why-grid">
        <article class="fr-why">
          <div class="fr-why-num">01</div>
          <h3>The Sugar Land playbook</h3>
          <p>
            Our flagship runs at $17,003 monthly revenue on a $25.13 average ticket — six months,
            steady ~3% MoM growth. You inherit those numbers as a baseline, not a sales pitch.
          </p>
        </article>
        <article class="fr-why">
          <div class="fr-why-num">02</div>
          <h3>Brand kit + facility renderings</h3>
          <p>
            3D renderings of the kitchen and counter, a brandbook every team member can read
            in an hour, and the tested floor plan that fits a 1,500–2,500 sqft Texas retail space.
          </p>
        </article>
        <article class="fr-why">
          <div class="fr-why-num">03</div>
          <h3>Recipes &amp; trademark</h3>
          <p>
            Hand-built cake "Honey", cake "Pistachio Roll", cake "Napoleon" — exactly the
            recipes our grandmothers handed down. Your Houston store tastes the same as your
            Austin store. That's the brand.
          </p>
        </article>
        <article class="fr-why">
          <div class="fr-why-num">04</div>
          <h3>AI sales &amp; ops, included</h3>
          <p>
            On-site chat assistant, owner Telegram bot, $500/month marketing engine, kitchen
            ticket flow, B2B office-box outreach. Everything we built for Sugar Land ships
            with your franchise on day one.
          </p>
        </article>
        <article class="fr-why">
          <div class="fr-why-num">05</div>
          <h3>Launch crew on-site</h3>
          <p>
            A HappyCake team flies into your city for the first 14 days — kitchen training,
            counter staffing, supplier handshakes, your first 25 Google reviews. We don't drop
            a manual and leave.
          </p>
        </article>
        <article class="fr-why">
          <div class="fr-why-num">06</div>
          <h3>Texas-wide supply chain</h3>
          <p>
            We negotiate flour, butter, eggs, packaging, and equipment leases across every
            Texas franchisee. Your unit economics get better the bigger the network gets.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="fr-section fr-econ-bg">
    <div class="wrap">
      <span class="fr-eyebrow centered">The numbers</span>
      <h2 class="fr-h2 centered">A Texas franchise <span class="fr-italic">in one table.</span></h2>
      <div class="fr-econ-grid">
        <div class="fr-econ"><span class="fr-econ-k">$250K – $400K</span><span class="fr-econ-v">Total initial investment</span></div>
        <div class="fr-econ"><span class="fr-econ-k">$35,000</span><span class="fr-econ-v">One-time franchise fee</span></div>
        <div class="fr-econ"><span class="fr-econ-k">6%</span><span class="fr-econ-v">Royalty on gross revenue</span></div>
        <div class="fr-econ"><span class="fr-econ-k">2%</span><span class="fr-econ-v">Marketing fund (network-wide)</span></div>
        <div class="fr-econ"><span class="fr-econ-k">6 months</span><span class="fr-econ-v">Royalty holiday for the first 3 Texas locations</span></div>
        <div class="fr-econ"><span class="fr-econ-k">18–25%</span><span class="fr-econ-v">Target pre-tax profitability</span></div>
        <div class="fr-econ"><span class="fr-econ-k">1,500–2,500 sqft</span><span class="fr-econ-v">Ground-floor retail with parking + kitchen vent</span></div>
        <div class="fr-econ"><span class="fr-econ-k">10 years</span><span class="fr-econ-v">Initial franchise term, two 5-year renewals</span></div>
      </div>
      <p class="fr-disclaimer">
        These figures are the planning baseline drawn from the Sugar Land flagship and US bakery-franchise norms.
        Actual franchise terms, financial performance representations, and disclosure documents are governed by
        an FDD provided to qualified prospects. Nothing on this page is an offer to sell a franchise; an offer
        is made only by an FDD in compliance with applicable state law.
      </p>
    </div>
  </section>

  <section class="fr-section">
    <div class="wrap">
      <span class="fr-eyebrow centered">How it works</span>
      <h2 class="fr-h2 centered">Four steps, four weeks of conversation, <span class="fr-italic">then we build.</span></h2>
      <ol class="fr-steps">
        <li>
          <span class="fr-step-n">1</span>
          <div>
            <h3>You apply</h3>
            <p>Send us the form below. We read every one. We aim to reply within one business day with whether your city is open and whether the timing fits.</p>
          </div>
        </li>
        <li>
          <span class="fr-step-n">2</span>
          <div>
            <h3>Discovery call</h3>
            <p>30 minutes on Zoom. We ask about your operating background, the city, your capital plan. You ask us anything about the playbook and the numbers.</p>
          </div>
        </li>
        <li>
          <span class="fr-step-n">3</span>
          <div>
            <h3>FDD &amp; site visit</h3>
            <p>We send the FDD, you send candidate locations, we fly to your city and walk every one. The right corner matters more than the cheaper rent.</p>
          </div>
        </li>
        <li>
          <span class="fr-step-n">4</span>
          <div>
            <h3>Sign &amp; build</h3>
            <p>Lease signed, kitchen built out, brand kit installed, your team trained at the Sugar Land flagship for 10 days, soft open, then the launch crew lands for two weeks.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="fr-section fr-form-bg" id="franchise-apply">
    <div class="wrap fr-form-wrap">
      <span class="fr-eyebrow centered">Apply</span>
      <h2 class="fr-h2 centered">Tell us about you <span class="fr-italic">and your Texas city.</span></h2>
      <p class="fr-form-intro centered">
        Every field below is required. Mandatory submission keeps the conversation tight and
        respects your time — when we reply, it's because we have something concrete to say.
      </p>

      <form id="fr-form" class="fr-form" autocomplete="off" novalidate>
        <div class="fr-row">
          <div class="fr-field">
            <label for="ff-name">Full name <span class="fr-req">*</span></label>
            <input id="ff-name" name="name" type="text" required minlength="2" maxlength="80" placeholder="First and last" />
          </div>
          <div class="fr-field">
            <label for="ff-email">Email <span class="fr-req">*</span></label>
            <input id="ff-email" name="email" type="email" required maxlength="254" placeholder="you@example.com" />
          </div>
        </div>

        <div class="fr-row">
          <div class="fr-field">
            <label for="ff-phone">Phone <span class="fr-req">*</span></label>
            <input id="ff-phone" name="phone" type="tel" required minlength="7" maxlength="32" placeholder="(281) 555-0199" />
          </div>
          <div class="fr-field">
            <label for="ff-city">Texas city or metro <span class="fr-req">*</span></label>
            <input id="ff-city" name="city" type="text" required minlength="2" maxlength="80" list="ff-cities" placeholder="Houston, Dallas, Austin…" />
            <datalist id="ff-cities">
              <option value="Houston"></option>
              <option value="Dallas"></option>
              <option value="Austin"></option>
              <option value="San Antonio"></option>
              <option value="Fort Worth"></option>
              <option value="El Paso"></option>
              <option value="Lubbock"></option>
              <option value="Amarillo"></option>
              <option value="Plano"></option>
              <option value="Irving"></option>
              <option value="Frisco"></option>
              <option value="The Woodlands"></option>
              <option value="Katy"></option>
              <option value="Pearland"></option>
              <option value="Round Rock"></option>
              <option value="Corpus Christi"></option>
            </datalist>
          </div>
        </div>

        <div class="fr-row">
          <div class="fr-field">
            <label for="ff-capital">Available capital <span class="fr-req">*</span></label>
            <select id="ff-capital" name="capital" required>
              <option value="">Pick a range…</option>
              <option value="250-400k">$250K – $400K (matches the recommended unit)</option>
              <option value="400-600k">$400K – $600K (room for premium location)</option>
              <option value="600k+">$600K+ (multi-unit appetite)</option>
              <option value="raising">Raising — talk to me anyway</option>
            </select>
          </div>
          <div class="fr-field">
            <label for="ff-timeline">Timeline to open <span class="fr-req">*</span></label>
            <select id="ff-timeline" name="timeline" required>
              <option value="">Pick a window…</option>
              <option value="0-3mo">Within 3 months</option>
              <option value="3-6mo">3–6 months</option>
              <option value="6-12mo">6–12 months</option>
              <option value="exploring">Just exploring</option>
            </select>
          </div>
        </div>

        <div class="fr-field">
          <label for="ff-message">Why HappyCake, why this city <span class="fr-opt">(optional)</span></label>
          <textarea id="ff-message" name="message" rows="4" maxlength="1000" placeholder="Operating background, target neighborhood, anything you want us to know."></textarea>
        </div>

        <button type="submit" class="btn btn-primary fr-submit">Send my application →</button>
        <p id="fr-status" class="fr-status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section class="fr-section">
    <div class="wrap">
      <span class="fr-eyebrow centered">FAQ</span>
      <h2 class="fr-h2 centered">The honest answers <span class="fr-italic">to the honest questions.</span></h2>
      <dl class="fr-faq">
        <dt>Is this an offer to sell a franchise?</dt>
        <dd>No. An offer is made only by an FDD in compliance with applicable state law. This page is informational; it gathers serious inquiries so we can talk.</dd>

        <dt>Why Texas only?</dt>
        <dd>The flagship is in Sugar Land, our supply chain is anchored in Houston, and the Texas Hispanic and traditional-family market is a strong fit for HappyCake's positioning. We will open other states later, after the Texas network proves out.</dd>

        <dt>Do I need bakery experience?</dt>
        <dd>No, but you do need operating experience — restaurant, retail, multi-unit, or military logistics. The kitchen craft we teach. The discipline of running a small store, you bring.</dd>

        <dt>Can I run multi-unit?</dt>
        <dd>Yes. The Texas plan reserves territory for operators committed to 3+ units in a metro. Tell us in the message field.</dd>

        <dt>How is HappyCake different from a US bakery franchise?</dt>
        <dd>Two ways. First, the recipe set is narrow and proven — we don't chase flavors of the week. Second, the AI sales and ops layer is real: chat, owner Telegram, marketing playbook. You don't bolt this on; it ships with the brand.</dd>
      </dl>
    </div>
  </section>

  <style>
    /* ===== Franchise page ===== */
    .fr-hero {
      position: relative;
      min-height: clamp(420px, 60vh, 600px);
      display: flex; align-items: end;
      isolation: isolate;
      overflow: hidden;
    }
    .fr-hero-photo {
      position: absolute; inset: 0; z-index: -2;
      width: 100%; height: 100%; object-fit: cover;
    }
    .fr-hero::after {
      content: ""; position: absolute; inset: 0; z-index: -1;
      background: linear-gradient(180deg, rgba(58,42,31,0.10) 0%, rgba(58,42,31,0) 30%, rgba(58,42,31,0.65) 100%);
    }
    .fr-hero-inner {
      width: 100%;
      max-width: var(--max);
      margin: 0 auto;
      padding: 64px var(--gutter);
      color: #fff;
    }
    .fr-hero h1 {
      color: #fff;
      font-family: var(--serif);
      font-size: clamp(36px, 5.5vw, 72px);
      line-height: 1.05;
      letter-spacing: -0.02em;
      font-weight: 400;
      margin: 0 0 18px;
      max-width: 18ch;
    }
    .fr-hero .fr-italic { font-style: italic; color: #F6E0BD; }
    .fr-hero .fr-lead {
      font-size: clamp(16px, 1.4vw, 19px);
      max-width: 56ch;
      color: rgba(255,255,255,0.92);
      margin: 0 0 28px;
      line-height: 1.5;
    }

    .fr-section { padding: clamp(56px, 8vw, 96px) 0; }
    .fr-section .wrap { max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter); }
    .fr-econ-bg { background: var(--cream-2); }
    .fr-form-bg { background: var(--cream-2); }

    .fr-eyebrow {
      font-family: var(--sans);
      font-size: 12px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--cocoa-soft);
      display: block;
      margin-bottom: 14px;
    }
    .fr-eyebrow.centered { text-align: center; }
    .fr-h2 {
      font-family: var(--serif);
      font-weight: 500;
      color: var(--cocoa);
      font-size: clamp(28px, 3.6vw, 44px);
      line-height: 1.05;
      letter-spacing: -0.015em;
      text-wrap: balance;
      margin: 0 0 clamp(28px, 4vw, 44px);
    }
    .fr-h2.centered { text-align: center; }
    .fr-italic { font-family: var(--serif); font-style: italic; font-weight: 400; }

    /* Why grid */
    .fr-why-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }
    @media (max-width: 880px) { .fr-why-grid { grid-template-columns: 1fr; } }
    .fr-why {
      background: #fff;
      border: 1px solid var(--cocoa-line);
      border-radius: var(--radius);
      padding: 26px 24px 24px;
      box-shadow: var(--shadow-sm);
    }
    .fr-why-num {
      font-family: var(--serif);
      font-style: italic;
      font-size: 28px;
      color: var(--honey-deep);
      margin-bottom: 10px;
    }
    .fr-why h3 {
      font-family: var(--serif);
      font-weight: 500;
      color: var(--cocoa);
      font-size: 22px;
      letter-spacing: -0.005em;
      margin: 0 0 8px;
    }
    .fr-why p {
      margin: 0;
      font-size: 15px;
      color: var(--cocoa-soft);
      line-height: 1.55;
    }

    /* Econ */
    .fr-econ-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
    @media (max-width: 1000px) { .fr-econ-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 540px) { .fr-econ-grid { grid-template-columns: 1fr; } }
    .fr-econ {
      background: #fff;
      border: 1px solid var(--cocoa-line);
      border-radius: var(--radius);
      padding: 22px 20px;
      display: flex; flex-direction: column; gap: 6px;
    }
    .fr-econ-k {
      font-family: var(--serif);
      font-weight: 500;
      font-size: 26px;
      color: var(--cocoa);
      letter-spacing: -0.01em;
    }
    .fr-econ-v {
      font-size: 13.5px;
      color: var(--cocoa-soft);
      line-height: 1.4;
    }
    .fr-disclaimer {
      margin: 28px auto 0;
      max-width: 70ch;
      font-size: 12.5px;
      color: var(--cocoa-soft);
      text-align: center;
      line-height: 1.55;
    }

    /* Steps */
    .fr-steps {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 22px;
    }
    @media (max-width: 720px) { .fr-steps { grid-template-columns: 1fr; } }
    .fr-steps li {
      background: #fff;
      border: 1px solid var(--cocoa-line);
      border-radius: var(--radius);
      padding: 24px 24px 22px;
      display: flex; gap: 18px; align-items: flex-start;
      box-shadow: var(--shadow-sm);
    }
    .fr-step-n {
      flex: none;
      width: 36px; height: 36px;
      border-radius: 50%;
      background: var(--honey);
      color: #fff;
      font-family: var(--serif);
      font-weight: 500;
      font-size: 18px;
      display: inline-flex; align-items: center; justify-content: center;
    }
    .fr-steps h3 {
      font-family: var(--serif);
      font-weight: 500;
      font-size: 21px;
      color: var(--cocoa);
      margin: 0 0 6px;
    }
    .fr-steps p {
      margin: 0;
      font-size: 15px;
      color: var(--cocoa-soft);
      line-height: 1.55;
    }

    /* Form */
    .fr-form-wrap { max-width: 820px; }
    .fr-form-intro {
      max-width: 60ch;
      margin: 0 auto 28px;
      color: var(--cocoa-soft);
      font-size: 15px;
      line-height: 1.55;
      text-align: center;
    }
    .fr-form {
      background: #fff;
      border: 1px solid var(--cocoa-line);
      border-radius: var(--radius);
      padding: clamp(20px, 3vw, 32px);
      box-shadow: var(--shadow);
    }
    .fr-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }
    @media (max-width: 640px) { .fr-row { grid-template-columns: 1fr; gap: 14px; } }
    .fr-field { margin-bottom: 18px; }
    .fr-row .fr-field { margin-bottom: 0; }
    .fr-row + .fr-field { margin-top: 18px; }
    .fr-field label {
      display: block;
      font-size: 13.5px;
      font-weight: 500;
      color: var(--cocoa);
      margin-bottom: 6px;
    }
    .fr-req { color: var(--honey-deep); }
    .fr-opt { color: var(--cocoa-soft); font-weight: 400; font-size: 12px; }
    .fr-field input,
    .fr-field select,
    .fr-field textarea {
      width: 100%;
      padding: 11px 12px;
      border: 1px solid var(--cocoa-line);
      border-radius: var(--radius-sm);
      background: var(--cream);
      font: inherit;
      font-size: 15px;
      color: var(--cocoa);
    }
    .fr-field input:focus,
    .fr-field select:focus,
    .fr-field textarea:focus {
      outline: 2px solid var(--honey);
      outline-offset: 1px;
      border-color: var(--honey);
      background: #fff;
    }
    .fr-field input.invalid,
    .fr-field select.invalid,
    .fr-field textarea.invalid {
      border-color: #b54a2c;
      background: #fdf3ee;
    }
    .fr-submit {
      margin-top: 20px;
      width: 100%;
      padding: 14px 20px;
      font-size: 16px;
    }
    .fr-status {
      margin: 16px 0 0;
      font-size: 14.5px;
      line-height: 1.5;
      color: var(--cocoa-soft);
      text-align: center;
    }
    .fr-status.ok { color: #2c6f3f; font-weight: 500; }
    .fr-status.err { color: #b54a2c; }

    /* FAQ */
    .fr-faq { max-width: 70ch; margin: 0 auto; }
    .fr-faq dt {
      font-family: var(--serif);
      font-weight: 500;
      font-size: 19px;
      color: var(--cocoa);
      margin-top: 22px;
    }
    .fr-faq dd {
      margin: 6px 0 0;
      color: var(--cocoa-soft);
      font-size: 15px;
      line-height: 1.6;
    }
  </style>

  <script is:inline define:vars={{ wrapperUrl: import.meta.env.PUBLIC_WRAPPER_URL ?? 'http://localhost:8000' }}>
    const form = document.getElementById('fr-form');
    const status = document.getElementById('fr-status');
    const fields = ['name', 'email', 'phone', 'city', 'capital', 'timeline'];

    const markInvalid = (names) => {
      // clear previous
      form.querySelectorAll('.invalid').forEach((el) => el.classList.remove('invalid'));
      names.forEach((n) => {
        const el = form.elements.namedItem(n);
        if (el && 'classList' in el) el.classList.add('invalid');
      });
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form).entries());

      // Client-side mandatory check — server enforces this too.
      const missing = fields.filter((f) => !String(data[f] || '').trim());
      if (missing.length) {
        markInvalid(missing);
        status.textContent = 'Please fill every required field — every one is mandatory.';
        status.className = 'fr-status err';
        const first = form.elements.namedItem(missing[0]);
        if (first && 'focus' in first) first.focus();
        return;
      }

      status.textContent = 'Sending your application…';
      status.className = 'fr-status';
      try {
        const r = await fetch(wrapperUrl + '/franchise', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const j = await r.json();
        if (j.ok) {
          markInvalid([]);
          status.textContent = j.message || 'Thanks — we have your details. A HappyCake partner will reach out within the next business day.';
          status.className = 'fr-status ok';
          form.reset();
        } else {
          markInvalid(Array.isArray(j.fields) ? j.fields : []);
          status.textContent = j.error === 'missing_or_invalid'
            ? 'A few fields need fixing — see the highlighted ones above.'
            : 'We could not save your application. Please try again, or email franchise@happycake.us.';
          status.className = 'fr-status err';
        }
      } catch (err) {
        status.textContent = "We couldn't reach the franchise team just now. Please try again, or email franchise@happycake.us with the same details.";
        status.className = 'fr-status err';
      }
    });
  </script>
</Layout>
