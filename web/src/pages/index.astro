---
import Layout from '../layouts/Layout.astro';
import { getCatalog, type Product } from '../lib/catalog';
import { withBase } from '../lib/url';
import Hero from '../components/Hero.astro';
import Divider from '../components/Divider.astro';
import CatalogCard from '../components/CatalogCard.astro';
import UseCaseTile from '../components/UseCaseTile.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import OfferCard from '../components/OfferCard.astro';
import PromiseSection from '../components/PromiseSection.astro';
import FindUs from '../components/FindUs.astro';

const catalog = getCatalog();

// Pick the three "today on the counter" cakes by slug from the catalog.
// Order matters — design shows: honey slice · whole honey · pistachio roll.
const featuredSlugs = ['honey-cake-slice', 'whole-honey-cake', 'pistachio-roll'];
const featured: Product[] = featuredSlugs
  .map(slug => catalog.products.find(p => p.slug === slug))
  .filter((p): p is Product => Boolean(p));

// Per-card meta overrides to match the design copy.
const metaOverrides: Record<string, string> = {
  'honey-cake-slice': '150 g · single serving',
  'whole-honey-cake': '1.2 kg · serves 8–10',
  'pistachio-roll':   '180 g · single serving',
};
---
<Layout
  title="HappyCake — The original taste of happiness"
  description="HappyCake is a family bakery in Sugar Land, Texas. Hand-built traditional cakes — pick up today, or order ahead."
  ogImage="/images/happy-cake-hero-01.webp"
>
  <Hero />

  <Divider />

  <!-- Today on the counter -->
  <section class="section" id="catalog" data-screen-label="Catalog Strip">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Today on the counter</span>
          <h2>Fresh-baked this morning,<br/><span class="serif-italic">ready when you are.</span></h2>
        </div>
        <a class="see-all" href={withBase('/catalog/')}>See all cakes →</a>
      </div>

      <div class="product-grid">
        {featured.map(p => (
          <CatalogCard product={p} metaText={metaOverrides[p.slug]} />
        ))}
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section class="section" style="padding-top: 0;" data-screen-label="Use Cases">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">For the moments that matter</span>
          <h2>Birthdays, Mondays,<br/><span class="serif-italic">and everything in between.</span></h2>
        </div>
      </div>

      <div class="usecase-grid">
        <UseCaseTile
          href="/custom/"
          photo="/images/happy-cake-product-04.webp"
          alt="A birthday cake topped with candles and berries"
          title="Birthdays"
          body="Whole cakes for the people you love most. Order Friday for Saturday — we've got you."
          cta="Custom orders"
        />
        <UseCaseTile
          href="/catalog/"
          photo="/images/happy-cake-product-05.webp"
          alt="An assortment of office-box cake slices in paper liners"
          title="The office"
          body="Sliced and boxed for meetings, client visits, and Friday afternoons. Standing weekly orders welcome."
          cta="Office boxes"
        />
        <UseCaseTile
          href="/catalog/"
          photo="/images/happy-cake-hero-02.webp"
          alt="A slice of cake with a cup of tea on a wooden table"
          title="Wednesday dinner"
          body="Because you don't need a reason. Pop in on the way home — slices ready at the counter all day."
          cta="Today's catalog"
        />
      </div>
    </div>
  </section>

  <Divider flip />

  <PromiseSection />

  <!-- Testimonials -->
  <section class="section testimonials-bg" data-screen-label="Testimonials">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Why people come back</span>
          <h2>Three customers,<br/><span class="serif-italic">in their own words.</span></h2>
        </div>
      </div>
      <div class="testimonial-grid">
        <TestimonialCard quote="Best honey cake in the area. Came for a birthday, leaving as a regular." author="M. R." />
        <TestimonialCard quote="We've been ordering from HappyCake for our office birthdays for months. Never disappointed." author="D. N." />
        <TestimonialCard quote="Lovely pistachio roll. Wish you delivered." author="J. S." />
      </div>
    </div>
  </section>

  <!-- Offers -->
  <section class="section" data-screen-label="Offers">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Offers this month</span>
          <h2>Small things <span class="serif-italic">we do for regulars.</span></h2>
        </div>
      </div>
      <div class="offers-grid">
        <OfferCard
          tag="Walk-in"
          title="Free slice with a Google review"
          body="Show us your review at the counter and pick a slice on the house. One per customer, while we're open."
          href="/policies/"
          cta="Get details"
        />
        <OfferCard
          tag="For the office"
          title="Weekly office box · $120 / week"
          body="An assortment for 10–12, delivered to your office every Friday morning. Cancel any week, no contract."
          href="/catalog/"
          cta="Start a standing order"
        />
        <OfferCard
          tag="For regulars"
          title="$5 off via WhatsApp"
          body="Order through WhatsApp on your second visit and we'll knock $5 off. Because coming back deserves a thank-you."
          href="https://wa.me/"
          cta="Message us"
        />
      </div>
    </div>
  </section>

  <FindUs />
</Layout>
