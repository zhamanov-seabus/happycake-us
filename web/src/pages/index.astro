---
import Layout from '../layouts/Layout.astro';
import { getCatalog, priceLabel } from '../lib/catalog';
import { withBase } from '../lib/url';
import { getCapacity, getInventory } from '../lib/sandbox';
import { readFileSync, existsSync } from 'node:fs';
import { resolve, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

const catalog = getCatalog();
const featured = catalog.products.filter(p => p.tags.includes('classic') || p.tags.includes('signature'));

// Live operational state from sandbox MCP (fetched at build time).
const [capacity, inventory] = await Promise.all([getCapacity(), getInventory()]);
const inventoryByVar = new Map(inventory.map(i => [i.variationId, i]));

// Load reviews if scripts/pull-reviews.py has been run.
const reviewsPath = resolve(dirname(fileURLToPath(import.meta.url)), '../../../data/reviews.json');
type Review = { id: string; author: string; rating: number; text: string; date: string };
type ReviewsFile = { fetchedAt: string; averageRating: number; totalCount: number; reviews: Review[] };
const reviewsData: ReviewsFile | null = existsSync(reviewsPath)
  ? JSON.parse(readFileSync(reviewsPath, 'utf-8'))
  : null;
const featuredReviews = (reviewsData?.reviews ?? []).filter(r => r.rating >= 4).slice(0, 3);

const aggregateRating = reviewsData && reviewsData.totalCount > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'AggregateRating',
  itemReviewed: { '@type': 'Bakery', name: 'HappyCake' },
  ratingValue: reviewsData.averageRating,
  reviewCount: reviewsData.totalCount,
} : null;
---
<Layout title="HappyCake — homemade cakes in Sugar Land">
  <section class="container hero">
    <div class="copy">
      <h1>It's just like homemade.</h1>
      <p class="lead">HappyCake makes the kind of cakes you remember. Tender layers, real cream, baked in our Sugar Land kitchen and ready by closing time.</p>
      {capacity && (
        <p class="capacity-badge" title="Live from the kitchen">
          {capacity.remainingCapacityMinutes >= 60 ? '🟢' : capacity.remainingCapacityMinutes > 0 ? '🟡' : '🔴'}
          &nbsp;Today: <strong>{capacity.remainingCapacityMinutes}</strong> min of capacity left ·
          {capacity.queuedTickets} queued · default lead {capacity.defaultLeadTimeMinutes} min
        </p>
      )}
      <p>
        <a href={withBase('/catalog/')} class="cta-link" style="background:var(--happy-blue);color:white;padding:0.7rem 1.4rem;border-radius:8px;text-decoration:none;font-weight:500;display:inline-block;">See today's cakes</a>
      </p>
    </div>
    <img src={withBase('/images/happy-cake-hero-01.webp')} alt="A whole honey cake on the counter at HappyCake Sugar Land." />
  </section>

  <section class="container">
    <h2>Today's classics</h2>
    <div class="grid">
      {featured.map(p => {
        const inv = inventoryByVar.get(p.variation_id);
        return (
          <article class="card">
            <a href={withBase(`/product/${p.slug}/`)}>
              <img src={withBase(p.photo)} alt={p.name} loading="lazy" />
            </a>
            <div class="body">
              <h3 set:html={p.display_name} />
              {inv && (
                <span class={`stock-pill ${inv.inStock ? 'in' : 'out'}`}>
                  {inv.inStock ? 'In stock today' : 'Sold out today'}
                </span>
              )}
              <p>{p.description}</p>
              <div class="meta">
                <span class="price">{priceLabel(p)}</span>
                <span class="weight">{p.weight}</span>
              </div>
              <a href={withBase(`/product/${p.slug}/`)} class="cta">View</a>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  {featuredReviews.length > 0 && (
    <section class="container reviews">
      <h2>What guests say</h2>
      {reviewsData && (
        <p class="rating-line">
          <span class="stars" aria-label={`${reviewsData.averageRating} out of 5`}>{'★'.repeat(Math.round(reviewsData.averageRating))}{'☆'.repeat(5 - Math.round(reviewsData.averageRating))}</span>
          <span> {reviewsData.averageRating.toFixed(1)} from {reviewsData.totalCount} reviews</span>
        </p>
      )}
      <div class="review-grid">
        {featuredReviews.map(r => (
          <blockquote class="review-card">
            <div class="stars">{'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}</div>
            <p>"{r.text}"</p>
            <footer>— {r.author}</footer>
          </blockquote>
        ))}
      </div>
      {aggregateRating && <script type="application/ld+json" set:html={JSON.stringify(aggregateRating)} />}
    </section>
  )}

  <section class="container">
    <h2>How ordering works</h2>
    <ol>
      <li>Pick a cake on the catalog or send us a message.</li>
      <li>Tell us the date and pickup time. We confirm within the hour.</li>
      <li>Whole cakes need 45 minutes' notice; catering 90 minutes; custom 3 hours and a quick chat.</li>
      <li>Pickup at the Sugar Land kitchen, or ask about local delivery.</li>
    </ol>
    <p>{catalog.business.closing_pattern}</p>
  </section>

  <section class="container lead-section">
    <div class="lead-card">
      <h2>Friday's bake-batch — first dibs</h2>
      <p>We bake the freshest assortment on Fridays. Drop your email and we'll send you a heads-up before the batch hits the counter.</p>
      <form id="lead-form" class="lead-form" autocomplete="off">
        <input id="lead-email" name="email" type="email" required placeholder="you@example.com" />
        <button type="submit" class="order-button">Get the heads-up</button>
      </form>
      <p id="lead-status" class="lead-status" aria-live="polite"></p>
    </div>
  </section>

  <script is:inline define:vars={{ wrapperUrl: import.meta.env.PUBLIC_WRAPPER_URL ?? 'http://localhost:8000' }}>
    const form = document.getElementById('lead-form');
    const status = document.getElementById('lead-status');
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('lead-email').value.trim();
        if (!email) return;
        status.textContent = 'Saving…';
        status.className = 'lead-status';
        try {
          const r = await fetch(wrapperUrl + '/lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, intent: 'friday-batch' }),
          });
          const j = await r.json();
          if (j.ok) {
            status.textContent = j.message || 'Got it.';
            status.className = 'lead-status ok';
            form.reset();
          } else {
            status.textContent = j.error || 'Could not save just now — try again in a moment.';
            status.className = 'lead-status err';
          }
        } catch (err) {
          status.textContent = 'Could not reach the system. Try again in a moment.';
          status.className = 'lead-status err';
        }
      });
    }
  </script>
</Layout>
