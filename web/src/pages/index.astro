---
import Layout from '../layouts/Layout.astro';
import { getCatalog, priceLabel } from '../lib/catalog';
import { withBase } from '../lib/url';
import { readFileSync, existsSync } from 'node:fs';
import { resolve, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

const catalog = getCatalog();
const featured = catalog.products.filter(p => p.tags.includes('classic') || p.tags.includes('signature'));

// Load reviews if scripts/pull-reviews.py has been run.
const reviewsPath = resolve(dirname(fileURLToPath(import.meta.url)), '../../../data/reviews.json');
type Review = { id: string; author: string; rating: number; text: string; date: string };
type ReviewsFile = { fetchedAt: string; averageRating: number; totalCount: number; reviews: Review[] };
const reviewsData: ReviewsFile | null = existsSync(reviewsPath)
  ? JSON.parse(readFileSync(reviewsPath, 'utf-8'))
  : null;
const featuredReviews = (reviewsData?.reviews ?? []).filter(r => r.rating >= 4).slice(0, 3);

const aggregateRating = reviewsData && reviewsData.totalCount > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'AggregateRating',
  itemReviewed: { '@type': 'Bakery', name: 'HappyCake' },
  ratingValue: reviewsData.averageRating,
  reviewCount: reviewsData.totalCount,
} : null;
---
<Layout title="HappyCake — homemade cakes in Sugar Land">
  <section class="container hero">
    <div class="copy">
      <h1>It's just like homemade.</h1>
      <p class="lead">HappyCake makes the kind of cakes you remember. Tender layers, real cream, baked in our Sugar Land kitchen and ready by closing time.</p>
      <p>
        <a href={withBase('/catalog/')} class="cta-link" style="background:var(--happy-blue);color:white;padding:0.7rem 1.4rem;border-radius:8px;text-decoration:none;font-weight:500;display:inline-block;">See today's cakes</a>
      </p>
    </div>
    <img src={withBase('/images/happy-cake-hero-01.webp')} alt="A whole honey cake on the counter at HappyCake Sugar Land." />
  </section>

  <section class="container">
    <h2>Today's classics</h2>
    <div class="grid">
      {featured.map(p => (
        <article class="card">
          <a href={withBase(`/product/${p.slug}/`)}>
            <img src={withBase(p.photo)} alt={p.name} loading="lazy" />
          </a>
          <div class="body">
            <h3 set:html={p.display_name} />
            <p>{p.description}</p>
            <div class="meta">
              <span class="price">{priceLabel(p)}</span>
              <span class="weight">{p.weight}</span>
            </div>
            <a href={withBase(`/product/${p.slug}/`)} class="cta">View</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  {featuredReviews.length > 0 && (
    <section class="container reviews">
      <h2>What guests say</h2>
      {reviewsData && (
        <p class="rating-line">
          <span class="stars" aria-label={`${reviewsData.averageRating} out of 5`}>{'★'.repeat(Math.round(reviewsData.averageRating))}{'☆'.repeat(5 - Math.round(reviewsData.averageRating))}</span>
          <span> {reviewsData.averageRating.toFixed(1)} from {reviewsData.totalCount} reviews</span>
        </p>
      )}
      <div class="review-grid">
        {featuredReviews.map(r => (
          <blockquote class="review-card">
            <div class="stars">{'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}</div>
            <p>"{r.text}"</p>
            <footer>— {r.author}</footer>
          </blockquote>
        ))}
      </div>
      {aggregateRating && <script type="application/ld+json" set:html={JSON.stringify(aggregateRating)} />}
    </section>
  )}

  <section class="container">
    <h2>How ordering works</h2>
    <ol>
      <li>Pick a cake on the catalog or send us a message.</li>
      <li>Tell us the date and pickup time. We confirm within the hour.</li>
      <li>Whole cakes need 45 minutes' notice; catering 90 minutes; custom 3 hours and a quick chat.</li>
      <li>Pickup at the Sugar Land kitchen, or ask about local delivery.</li>
    </ol>
    <p>{catalog.business.closing_pattern}</p>
  </section>
</Layout>
