---
import '../styles/global.css';
import Assistant from '../components/Assistant.astro';
import { getCatalog } from '../lib/catalog';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const catalog = getCatalog();
const b = catalog.business;

const fullTitle = title.includes(b.name) ? title : `${title} — ${b.name}`;
const desc = description ?? `${b.tagline} ${b.slogan} HappyCake in Sugar Land, Texas.`;
const og = ogImage ?? '/images/happy-cake-hero-01.webp';
const ogAbs = og.startsWith('http') ? og : `${Astro.site}${withBase(og).replace(/^\//, '')}`;

// LocalBusiness JSON-LD — present on every page
const siteRoot = Astro.site?.toString().replace(/\/$/, '') ?? '';
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'Bakery',
  name: b.name,
  legalName: b.legal_name,
  slogan: b.slogan,
  url: `${siteRoot}${withBase('/')}`,
  image: `${siteRoot}${withBase('/images/happy-cake-hero-01.webp')}`,
  logo: `${siteRoot}${withBase('/images/logo.png')}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: b.location.city,
    addressRegion: b.location.state,
    addressCountry: 'US',
  },
  servesCuisine: 'Bakery, Desserts',
  priceRange: '$$',
  openingHoursSpecification: Object.entries(b.hours).map(([day, range]) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: day.charAt(0).toUpperCase() + day.slice(1),
    opens: range.split('–')[0],
    closes: range.split('–')[1],
  })),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogAbs} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href={withBase('/images/logo.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
  </head>
  <body>
    <header class="nav" id="nav">
      <div class="nav-inner">
        <a href={withBase('/')} class="wordmark" aria-label="HappyCake home">
          <img class="wordmark-logo" src={withBase('/images/logo.png')} alt="HappyCake" />
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href={withBase('/catalog/')}>Catalog</a>
          <a href={withBase('/custom/')}>Custom</a>
          <a href={withBase('/order-status/')}>Status</a>
          <a href={withBase('/policies/')}>Policies</a>
          <a href={withBase('/about/')}>About</a>
        </nav>
        <a class="btn btn-primary btn-sm nav-cta-desktop" href="https://wa.me/" target="_blank" rel="noopener">
          <svg class="wa-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9s-.5-.1-.6.1c-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.4-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.2-.5.1-.2 0-.4 0-.5s-.6-1.5-.9-2c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.4s-.9.9-.9 2.2.9 2.5 1 2.7c.1.2 1.8 2.8 4.5 3.9 2.2.9 2.7.7 3.2.7s1.7-.7 1.9-1.4c.2-.6.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3zM12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.5 1.3 5L2 22l5.1-1.3c1.4.8 3.1 1.2 4.9 1.2 5.5 0 10-4.5 10-10S17.5 2 12 2z"/></svg>
          Order on WhatsApp
        </a>
        <button class="nav-mobile-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M4 7h16M4 12h16M4 17h16"/>
          </svg>
        </button>
      </div>
    </header>
    <div class="mobile-menu" id="mobileMenu">
      <a href={withBase('/catalog/')}>Catalog</a>
      <a href={withBase('/custom/')}>Custom</a>
      <a href={withBase('/order-status/')}>Status</a>
      <a href={withBase('/policies/')}>Policies</a>
      <a href={withBase('/about/')}>About</a>
      <a class="btn btn-primary" href="https://wa.me/" target="_blank" rel="noopener">
        <svg class="wa-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9s-.5-.1-.6.1c-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.4-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.2-.5.1-.2 0-.4 0-.5s-.6-1.5-.9-2c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.4s-.9.9-.9 2.2.9 2.5 1 2.7c.1.2 1.8 2.8 4.5 3.9 2.2.9 2.7.7 3.2.7s1.7-.7 1.9-1.4c.2-.6.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3zM12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.5 1.3 5L2 22l5.1-1.3c1.4.8 3.1 1.2 4.9 1.2 5.5 0 10-4.5 10-10S17.5 2 12 2z"/></svg>
        Order on WhatsApp
      </a>
    </div>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap">
        <div class="footer-top">
          <div class="footer-col">
            <a href={withBase('/')} class="wordmark wordmark-footer" aria-label="HappyCake home"><img class="wordmark-logo" src={withBase('/images/logo.png')} alt="HappyCake" /></a>
            <p>The original taste of happiness. Hand-built cakes, baked the way they used to be — in Sugar Land, Texas.</p>
            <a href="https://instagram.com/" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
              @happycake
            </a>
          </div>
          <div class="footer-col">
            <h4>Cakes</h4>
            <a href={withBase('/catalog/')}>Catalog</a>
            <a href={withBase('/custom/')}>Custom orders</a>
          </div>
          <div class="footer-col">
            <h4>Customers</h4>
            <a href={withBase('/order-status/')}>Order status</a>
            <a href={withBase('/policies/')}>Policies & FAQ</a>
            <a href={withBase('/about/')}>About</a>
          </div>
          <div class="footer-col">
            <h4>Visit</h4>
            <a href="#findus">Hours &amp; address</a>
            <a href="https://wa.me/" target="_blank" rel="noopener">WhatsApp</a>
          </div>
          <div class="footer-col">
            <h4>Partner</h4>
            <a href={withBase('/franchise/')}>Franchise — Texas</a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© 2026 HappyCake US — {b.location.city}, {b.location.state}.</span>
          <span>{b.tagline}</span>
        </div>
      </div>
    </footer>
    <Assistant />
    <script is:inline>
      // Sticky-nav scrolled state + mobile menu toggle.
      (() => {
        const nav = document.getElementById('nav');
        const onScroll = () => nav && nav.classList.toggle('is-scrolled', window.scrollY > 8);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });

        const t = document.getElementById('navToggle');
        const m = document.getElementById('mobileMenu');
        t?.addEventListener('click', () => {
          const open = m.classList.toggle('open');
          t.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        m?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
          m.classList.remove('open');
          t?.setAttribute('aria-expanded', 'false');
        }));

        // Highlight today's row on the Find-us hours table if present.
        const todayIdx = new Date().getDay();
        const rowMap = { 1:0, 2:0, 3:0, 4:0, 5:1, 6:2, 0:3 };
        const rows = document.querySelectorAll('.hours tbody tr');
        if (rows[rowMap[todayIdx]]) rows[rowMap[todayIdx]].classList.add('today');
      })();
    </script>
  </body>
</html>
